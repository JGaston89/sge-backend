# ─── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sge_db
DB_USER=sge_user
DB_PASSWORD=your_secure_password
DB_POOL_MAX=20
DB_SSL=false

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_ANOTHER_64_BYTE_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Seguridad ────────────────────────────────────────────────
BCRYPT_ROUNDS=12
THROTTLE_TTL=900000
THROTTLE_LIMIT=5

# ─── 2FA ──────────────────────────────────────────────────────
OTP_ISSUER=SistemaGestionEducativa

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001

# ─── AWS S3 (Fase 2) ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=sge-documentos

# ─── Email (Fase 2) ───────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@tuinstitucion.edu.ar
